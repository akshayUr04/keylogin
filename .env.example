# ── Application environment configuration ─────────────────────────────────────
# Copy this file to .env and fill in the values.
# For production, export these as real environment variables instead.

# ── Server ─────────────────────────────────────────────────
PORT=8080
ENV=development
BASE_DOMAIN=localhost
LOG_LEVEL=debug

# ── Database ────────────────────────────────────────────────
DATABASE_URL=postgres://iam_user:iam_secret@localhost:5432/saas_iam?sslmode=disable

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://:redis_secret@localhost:6379/0

# ── Keycloak ────────────────────────────────────────────────
# Point to your Keycloak server (no trailing slash)
KEYCLOAK_URL=http://localhost:8081

# Master realm super-admin credentials (ROPC grant for admin API access)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASS=Admin1234!

# Realm name for the master/super-admin realm
KEYCLOAK_MASTER_REALM=master

# The confidential client configured in Keycloak for the backend
# Create this client in the master realm with:
#   - Client authentication: ON
#   - Direct access grants: ON
#   - Service accounts: ON
KEYCLOAK_CLIENT_ID=saas-iam-backend
KEYCLOAK_CLIENT_SECRET=change-me-in-production

# Keycloak URL as seen by the browser (may differ from KEYCLOAK_URL in Docker)
KEYCLOAK_FRONTEND_URL=http://localhost:8081

# ── PKCE Clients (public, no client_secret) ─────────────────────
# Create these clients in Keycloak with:
#   - Client authentication: OFF (public client)
#   - Standard flow: ON
#   - Direct access grants: OFF
#   - PKCE Code Challenge Method: S256
#   - Valid redirect URIs: set to the corresponding redirect URL below

# Admin portal PKCE client (created in master realm)
PKCE_ADMIN_CLIENT_ID=saas-iam-admin
PKCE_ADMIN_REDIRECT_URL=http://localhost:8080/admin/callback

# User portal PKCE client (created in each tenant realm)
PKCE_USER_CLIENT_ID=saas-iam-user
PKCE_USER_REDIRECT_URL=http://localhost:8080/user/callback

# ── Security ────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-must-be-32-or-more-bytes
SESSION_TTL=8h

# ── CORS ────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# ── Rate limiting ────────────────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m

# ── Features ────────────────────────────────────────────────
AUDIT_ENABLED=true
