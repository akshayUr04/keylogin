# ── Application environment configuration ─────────────────────────────────────
# Copy this file to .env and fill in the values.
# For production, export these as real environment variables instead.

# ── Server ─────────────────────────────────────────────────
PORT=8080
ENV=development
BASE_DOMAIN=localhost
LOG_LEVEL=debug

# ── Database ────────────────────────────────────────────────
DATABASE_URL=postgres://iam_user:iam_secret@localhost:5432/saas_iam?sslmode=disable

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://:redis_secret@localhost:6379/0

# ── Keycloak ────────────────────────────────────────────────
# Point to your Keycloak server (no trailing slash)
KEYCLOAK_URL=http://localhost:8081

# Master realm super-admin credentials (ROPC grant for admin API access)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASS=Admin1234!

# Realm name for the master/super-admin realm
KEYCLOAK_MASTER_REALM=master

# The confidential client configured in Keycloak for the backend
# Create this client in the master realm with:
#   - Client authentication: ON
#   - Direct access grants: ON
#   - Service accounts: ON
KEYCLOAK_CLIENT_ID=saas-iam-backend
KEYCLOAK_CLIENT_SECRET=change-me-in-production

# ── Security ────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-must-be-32-or-more-bytes
SESSION_TTL=8h

# ── CORS ────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# ── Rate limiting ────────────────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m

# ── Features ────────────────────────────────────────────────
AUDIT_ENABLED=true
